# scripts/soak 运行时注入样例（coldstart-selfheal-plan §四：零凭据入库，机密全走 env.local）
# 用法：把本文件复制到运行时目录并改名为 env.local，填入真实值：
#   mkdir -p ~/nms-rebuild-<日期> && cp scripts/soak/env.local.example ~/nms-rebuild-<日期>/env.local
#   export SOAK_ENV=~/nms-rebuild-<日期>
# env.local 永不入库（仓内 .gitignore 已挡 *.local.json；运行时目录在仓外）。占位符一律 <...> 形式。

# ---- 必填：机密与部署事实 ----
NODE_PASS='<节点统一密码占位>'                 # 全 fleet 测试节点 root 密码（s4 导入/r* 复活载荷用）
AUTHORIZED_KEY='<ssh-ed25519 AAAA... your_key_comment 占位>'  # 注入节点 /root/.ssh/authorized_keys 的公钥（整行公钥文本）
OLD_NMS_IP='<现网 NMS IPv4 占位>'              # S0 基线目标；重建重跑时 S0 会按 DO 盘点自动纠正
NMS_ACCOUNT='<NMS 所在账号名占位>'             # NMS 固定账号——无账号名常量（coldstart §四）
#（零防火墙口径 v3.3/v3.4，2026-09-21：EGRES_EXPECT/FW_SOAK_NMS_ID/DRILL_FW_EXTRA_SOURCES
#  三键退役——不再必填、不再参与任何断言/塑形；旧 env.local 里留着无害，仅被忽略。）

# ---- 全 fleet sshd 高位口（v3.4 定版 40222）----
SSHD_PORT=40222                               # 两 user-data 模板 Port+全部 ssh/scp+inject 跳板+
                                              #   W-B iptables+vpsctl -ssh-port 单源；缺省见 lib/env.sh
# ---- WG 隧道（v3.4 票 2：编排机↔NMS 单边；80 单绑隧道地址）----
#NMS_API_ADDR=10.100.0.1                      # API 腿基址（缺省即此值；退化「无 WG 版」时切回
#                                              #   NMS 公网 IP 即可，全链自动跟随）
# 密钥不进 env.local——s2 开头 wg genkey 现生成落 evidence/s2/wg/（0600，每轮重建即重生成、
# 跨演练不复用），经文件句柄 NMS_WG_PRIV_FILE/NMS_WG_PEER_PUB_FILE 注入模板（进程环境零私钥值）。
# NO_PROXY/no_proxy 由 lib/env.sh 自动并入 10.100.0.0/24,127.0.0.1（大小写双变量、合并不覆盖）。

# ---- 必填：区域/账号分布表（s3 消费；账号列注入，每行="区域 账号 台数 机型"）----
# 台数合计必须 == NODE_COUNT（64）；s3 会对账，不符直接 ABORT。下例即 65 台规模验证用的
# 区域/尺寸/台数分布（区域→账号的对应关系属注入事实，账号名不得写进本仓任何文件）。
SOAK_BATCHES='sgp1 <账号A占位> 11 s-1vcpu-1gb
nyc1 <账号A占位> 8 s-1vcpu-1gb
lon1 <账号B占位> 8 s-1vcpu-1gb
tor1 <账号B占位> 8 s-1vcpu-1gb
blr1 <账号B占位> 6 s-1vcpu-1gb
fra1 <账号C占位> 8 s-1vcpu-1gb
syd1 <账号C占位> 7 s-1vcpu-1gb
atl1 <账号C占位> 8 s-1vcpu-1gb-amd'

# ---- 可选：S1 保护账号断言（不设则跳过该保护断言，误伤将无检测）----
#GUARD_ACCOUNT='<不拆除的存量账号占位>'
#GUARD_ACCOUNT_EXPECT=8

# ---- 可选：现场修复目标清单（tools/heal-*；空格分隔节点名，不设则 heal 脚本拒绝运行）----
#HEAL_TARGETS='<节点名占位> <节点名占位>'
#DRILL_SSH_KEY=$HOME/.ssh/<私钥占位>   # 与 AUTHORIZED_KEY 配对的 WSL 私钥——静默窗注入单元
#                                      #   link-block-new/threshold-stress/slow-agent 登节点用
#                                      #   （票 0-10；Step 0 项 1 实测配对后方可非 DRY 运行）
#NMS_SSH_VIA=auto                      # 管理通道自适应（2026-09-21）：lib/net-probe.sh 探测
#                                      #   fake-IP/raw22 截杀→stunnel443；净通道且 NMS sshd（$SSHD_PORT）
#                                      #   通→direct。也可写死 direct/stunnel443。
#                                      #   （v3.4 起出口仅记录——零防火墙口径无白名单可覆盖）
#DRILL_EGRES_AUTO=0                    # 保留键（net-probe 记录用；白名单机制已退役）

# ---- 可选覆盖：非机密缺省值见 scripts/soak/lib/env.sh ----
#NODE_COUNT=64                # 测试节点数（不含 NMS）
#FIRST_HOP_COUNT=9            # 第一跳（domain0）台数
#CHILD_BUDGET=3               # 与 S2 PUT config 的 child_budget 同值
#G5_MAX_DEPTH=6               # G5' 深度门限覆盖（缺省 fresh 4 / resume 7；R+L 演练 79 台/FH=2/出度 2
#                              #   构成式最小可行深度=6，低于它 s5 预检直接 FAIL——票 0-4）
#NMS_REGION=sgp1              # S2 NMS 固定建区
#NMS_NAME_PREFIX=soaknms      # s4 剔除 NMS 机的识别前缀
#EXPECT_HEAD='<当轮 main 终点占位>'   # 被测构建；run-benchmark 以环境变量覆盖
#NMS2_REPO=$HOME/NMS2
#VPSCTL=$HOME/vpsctl/bin/vpsctl
#VPSCTL_ACCOUNTS=$HOME/.config/vpsctl/accounts.json   # DO token 所在文件，永不入库
